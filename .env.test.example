# For the RLS security tests (npm run test:rls).
# Copy this file to .env.test.local and fill in the demo account passwords.
# .env.test.local is ignored by Git. Never commit real passwords.
TEST_ADMIN_PASSWORD=
TEST_STAFF_PASSWORD=
TEST_EMPLOYEE_PASSWORD=

# Optional: only needed if your demo emails differ from the defaults below.
# TEST_ADMIN_EMAIL=admin@helpdesk.test
# TEST_STAFF_EMAIL=staff@helpdesk.test
# TEST_EMPLOYEE_EMAIL=employee@helpdesk.test
